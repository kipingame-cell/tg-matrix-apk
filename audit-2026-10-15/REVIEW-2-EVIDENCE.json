  "findings": [
    {
      "id": "TG-MATRIX-APK-R2-APK",
      "priority": "P2",
      "title": "Опубликованный установщик имеет debuggable=true",
      "file": ".github/workflows/build.yml",
      "line": 39,
      "proof": "Проверен APK build-9-3590911dfce2, asset 621366740. SHA-256 aefbb545482dc0e5948352f62b86831c9442e8f6841350f68327a26336f447f5 совпал с GitHub digest. apksigner verify: 0; aapt dump badging: application-debuggable. Сертификат — Android Debug. Это проверка настоящего бинарника, а не предположение по имени файла.",
      "impact": "Development-сборка не отделена технически от установщика, который пользователь получает из Releases. Для production требуется отдельный режим выпуска. Это не доказательство удалённого взлома и не означает, что подпись математически некорректна.",
      "fix": "Выделить production-выпуск с debuggable=false, приватной стабильной подписью, неизменяемыми версиями и проверкой upgrade. Development APK явно маркировать.",
      "acceptance": "aapt на production APK не выводит application-debuggable; сертификат совпадает между последовательными production версиями; обновление сохраняет данные."
    }
  ],
